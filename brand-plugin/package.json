{
  "name": "dsh-claude-brand",
  "version": "1.0.0",
  "description": "Rebrands the DSH Web GUI as Claude: the Anthropic starburst mark in the sidebar and hero, a text wordmark, and the document title.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "author": "aklnaaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/aklnaaw/dsh-claude-theme.git",
    "directory": "brand-plugin"
  },
  "homepage": "https://github.com/aklnaaw/dsh-claude-theme#readme",
  "bugs": {
    "url": "https://github.com/aklnaaw/dsh-claude-theme/issues"
  }
}
