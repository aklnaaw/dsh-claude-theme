{
  "name": "dsh-font-switcher",
  "version": "0.1.0",
  "description": "换掉 Claude 皮肤用的三组字体（正文衬线、界面无衬线、代码等宽），字体文件放进指定文件夹即可。",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "type": "module"
}
