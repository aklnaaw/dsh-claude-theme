{
  "name": "dsh-claude-crab",
  "version": "1.1.0",
  "description": "A clickable pixel Clawd on the composer edge: follows the pointer, blinks, dozes off when ignored, and answers according to what the page is doing.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "clawd",
    "claude-code",
    "mascot"
  ],
  "author": "aklnaaw",
  "repository": {
    "type": "git",
    "url": "https://github.com/aklnaaw/dsh-claude-theme.git",
    "directory": "crab-plugin"
  },
  "homepage": "https://github.com/aklnaaw/dsh-claude-theme#readme",
  "bugs": {
    "url": "https://github.com/aklnaaw/dsh-claude-theme/issues"
  }
}
